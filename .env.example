# Penetration Tool environment template
# Copy this file to .env for local development, then fill in real values.
# Do not commit real .env or .env.production files.

PORT=3000
NODE_ENV=development

# OpenCode local service configuration
OPENCODE_PORT=4096
OPENCODE_API_URL=http://127.0.0.1:4096
OPENCODE_API_KEY=

# DeepSeek OpenAI-compatible Chat Completions API
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Windows Go cross-compilation toolchain
# Verified with Go 1.22.12 linux/amd64 in the current deployment environment.
GO_PATH=/usr/local/go/bin/go
