# 站点监听端口
PORT=3000
NODE_ENV=production

# OpenCode 本地服务配置
OPENCODE_PORT=4096
OPENCODE_API_URL=http://127.0.0.1:4096
OPENCODE_API_KEY=

# DeepSeek 兼容 OpenAI Chat Completions 接口
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=请填写你的 DeepSeek API Key

# Windows Go 交叉编译工具链
GO_PATH=/usr/local/go/bin/go
